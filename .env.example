# Coze 工作流（服务端调用，勿提交密钥）

# 发布页 HTTP 入口（未设置则默认使用内置演示 URL）
COZE_WORKFLOW_RUN_URL=https://vkpkbmtz48.coze.site/run

# 发布页 Bearer；同一工作流内若节点还读取 body 中的 POLICY_API_TOKEN，默认也用该值（勿提交到 Git）
COZE_WORKFLOW_TOKEN=

# 可选：仅当「政策 API」与上面令牌不同时单独填写；不要写 POLICY_API_TOKEN= 留空（留空会等同于未配置）
# POLICY_API_TOKEN=

# 设为 1 则完全不请求远程，仅用本地 Mock（离线开发 / 线上演示部署推荐开启）
# COZE_WORKFLOW_USE_MOCK=1

# 线上演示部署：首页顶栏展示演示账号说明（vercel.json 已默认配置）
# NEXT_PUBLIC_DEMO_MODE=1

# 若工作流一直报「未找到 POLICY_API_TOKEN」：可试 parameters / both / input / max（见代码注释）；max 会多路径嵌套同一份参数
# flat（默认）| parameters | both | input | max
# COZE_WORKFLOW_BODY_MODE=max

# 若网关过滤含 TOKEN 的 JSON 键，可改字段名并同步改 Coze 里读取的键名；留空则使用 POLICY_API_TOKEN
# COZE_POLICY_TOKEN_FIELD=

# ---------- Coze 开放平台（店长看板：Workspace 已发布 Bot）----------
# PAT（可与店长工作流 C 共用变量名 COZE_WORKFLOW_C_TOKEN，见 lib/cozeOpenApi.ts）
COZE_WORKLOAD_API_TOKEN=
COZE_LOOP_BASE_URL=https://api.coze.cn
COZE_WORKSPACE_ID=
# 可选别名（与工作流 C 区块对齐）
# COZE_WORKFLOW_C_TOKEN=
# COZE_WORKFLOW_C_URL=https://api.coze.cn
# COZE_WORKFLOW_C_WORKSPACE_ID=

# ---------- 工作流 A / B / C（各自发布页；仍全部写在这一份 .env.local 里）----------
# 默认对话入口可用上面的 COZE_WORKFLOW_RUN_URL / COZE_WORKFLOW_TOKEN。
# 店长侧对应「工作流 C」：若服务端要单独 POST 调用 C 的发布页，可配置例如：
# COZE_WORKFLOW_C_RUN_URL=https://....../run
# COZE_WORKFLOW_C_TOKEN=
# 当前「本店看板」拉 Bot 数量用的是开放平台 PAT（上一段），不是工作流 C 的 run。
