# 复制为 .env.local 后再填写。不要把真实密钥写进源码或网页。
# 生文地址固定为产品机会研究同一套兼容接口，不在这里改。

DASHSCOPE_API_KEY=
QWEN_FREE_TIER_ONLY_CONFIRMED=false
GUIDE_AGENT_LIVE_MODEL=false

# 生图与生文分开。只填写一个模型名（例如 qwen-image-3.0）。
# 也支持 wan2.6-image：官方阿里云域名会自动采用万相原生异步接口。
# 默认完整4张，可选试生成1张；万相 max_images 随选项限制为4或1，不传商品本地图片路径。
# IMAGE_API_BASE 可填控制台北京业务空间的 compatible-mode/v1 根地址。
# IMAGE_MODEL 必须是生图模型，不能填生文模型 qwen3.7-plus / qwen-plus。
# 也可使用官方推荐的 DashScope 同步完整地址（程序会采用对应嵌套请求格式）：
# https://<业务空间ID>.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# IMAGE_API_KEY 可单独填写；仅当地址为官方 HTTPS 阿里云域名时，留空才复用 DASHSCOPE_API_KEY。
# npm run doctor 检查实际生效配置及覆盖来源，不发请求、不扣费。
# .env.local 优先于 .env，修改后必须重启服务。
# GUIDE_IMAGE_ENABLED=false 时，即使下面三项已填也不请求生图。接口失败会显示 HTTP 状态或「返回里没有图片地址」，不改写文案，也不改已确认商品。
IMAGE_API_BASE=
IMAGE_MODEL=
IMAGE_API_KEY=
GUIDE_IMAGE_ENABLED=false

# 飞书知识库默认同步关闭。三个编号都留空，且 FEISHU_SYNC_ENABLED 不是 true 时，不会访问飞书。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WIKI_SPACE_ID=
FEISHU_SYNC_ENABLED=false

# 远程召回与重排序默认关闭。嵌入地址或嵌入密钥留空，或 GUIDE_RAG_REMOTE_CONFIRMED 不是 true 时，不发请求，改用进程内演示检索。
# 召回地址写 compatible-mode/v1 根路径，不要写成 /chat/completions。请求是 POST {GUIDE_RAG_EMBED_BASE}/embeddings。
# 默认模型 qwen3.7-text-embedding。一次请求最多 20 条 input。
GUIDE_RAG_EMBED_BASE=
GUIDE_RAG_EMBED_API_KEY=
GUIDE_RAG_EMBED_MODEL=qwen3.7-text-embedding
# 重排序不走 /rerank（该路径会 404）。地址由嵌入主机派生，走 DashScope text-rerank：
# POST {host}/api/v1/services/rerank/text-rerank/text-rerank
# 默认模型 qwen3.7-text-rerank。重排序密钥留空时使用嵌入密钥。
GUIDE_RAG_RERANK_BASE=
GUIDE_RAG_RERANK_API_KEY=
GUIDE_RAG_RERANK_MODEL=qwen3.7-text-rerank
GUIDE_RAG_REMOTE_CONFIRMED=false
