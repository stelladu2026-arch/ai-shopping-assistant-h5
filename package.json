{
  "name": "ai-shopping-assistant-h5",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 WATCHPACK_POLLING=1 next dev -H 0.0.0.0 -p 3000",
    "dev:turbo": "cross-env NODE_OPTIONS=--max-old-space-size=4096 WATCHPACK_POLLING=1 next dev -H 0.0.0.0 -p 3000 --turbo",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "package:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-frontend.ps1",
    "deploy:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-demo.ps1",
    "deploy:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-demo.ps1 -Preview"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.20",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"
  }
}
